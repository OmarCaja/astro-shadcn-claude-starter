{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ \"$(basename \"$f\" 2>/dev/null)\" = new-project.sh ] && shellcheck \"$f\""
          }
        ]
      }
    ]
  }
}
